# Analytics (optional — public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site URL (optional — public; set on Cloud Run / build-arg)
NEXT_PUBLIC_SITE_URL=

# Payments — never commit real values; on Cloud Run use Secret Manager
# Secret IDs (see docs/deploy-cloud-run.md):
#   narayan-razorpay-key-id → RAZORPAY_KEY_ID
#   narayan-razorpay-key-secret → RAZORPAY_KEY_SECRET
#   narayan-razorpay-webhook-secret → RAZORPAY_WEBHOOK_SECRET
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database (Cloud SQL / Postgres). Leave empty for seed-file catalogue fallback.
# Secret ID: narayan-database-url → DATABASE_URL
# Example socket form:
#   postgresql://USER:PASSWORD@/narayan?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Cloud Run runtime (set automatically in Dockerfile / service)
# PORT=8080
# HOSTNAME=0.0.0.0
# NODE_ENV=production
